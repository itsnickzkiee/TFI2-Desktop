TFI_SUPABASE_URL=https://YOUR-TFI2-PROJECT.supabase.co
TFI_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
TFI_HOST=127.0.0.1
TFI_PORT=5100
# 0 = idle timeout not enforced until the approved session policy is connected.
TFI_SESSION_IDLE_TIMEOUT_SECONDS=0
TFI_DEBUG=false

# Google Sheets read-only OAuth (create a Google Cloud OAuth client: Web application).
# Authorized redirect URI: http://127.0.0.1:5100/api/google-sheets/callback
# Keep the client secret private; never put either value in frontend JavaScript.
TFI_GOOGLE_CLIENT_ID=
TFI_GOOGLE_CLIENT_SECRET=
